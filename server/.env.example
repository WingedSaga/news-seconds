# Порт HTTP-сервера
PORT=4000

# Окружение: development | production
NODE_ENV=development

# Подключение к Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Сервисный ключ. Используется только на сервере, никогда не публикуется в клиенте.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Название бакета Supabase Storage для картинок статей
SUPABASE_STORAGE_BUCKET=article-images
# Бакет для аудио и видео, прикреплённых к новостям
SUPABASE_MEDIA_BUCKET=article-media
# Предел одного файла в хранилище: на бесплатном тарифе Supabase это 50 МБ.
# Сервер принимает до 100 МБ и пережимает всё, что не влезает, — для этого
# нужен ffmpeg: sudo apt install -y ffmpeg
SUPABASE_MEDIA_MAX_BYTES=52428800
# Путь к ffmpeg, если он не в PATH
FFMPEG_PATH=

# Секрет для подписи JWT (длинная случайная строка)
JWT_SECRET=change-me-to-a-long-random-string
# Срок жизни токена
JWT_EXPIRES_IN=7d

# Разрешённые источники запросов, через запятую
CORS_ORIGIN=http://localhost:5173,https://your-github-username.github.io

# Адрес фронтенда — из него собирается ссылка в письме подтверждения
CLIENT_URL=http://localhost:5173

# Stripe: разовая поддержка через Stripe Checkout.
# Используйте ограниченный ключ rk_test_/rk_live_ с минимальными правами,
# а не публикуйте ключ в клиенте или Git. Реальный ключ хранится только в server/.env.
STRIPE_SECRET_KEY=
# Публичный ключ допускается только во фронтенде. Stripe Checkout его не использует,
# но он пригодится, если в будущем будет добавлен встроенный Payment Element.
STRIPE_PUBLISHABLE_KEY=
# Секрет подписи webhook из Stripe Workbench. Начинается с whsec_.
STRIPE_WEBHOOK_SECRET=
# Идентификатор существующей цены подписки (price_...).
STRIPE_SUBSCRIPTION_PRICE_ID=

# Подтверждение почты включается и выключается в админ-панели,
# раздел «Управление сайтом». Здесь настраивается только способ отправки.

# Отправка писем с подтверждением почты. Способ выбирается автоматически:
# BREVO_API_KEY -> RESEND_API_KEY -> SMTP. Если не задано ничего,
# проверка почты выключается и аккаунты создаются сразу подтверждёнными.

# Вариант 1, рекомендуемый: Brevo поверх HTTPS (app.brevo.com, SMTP & API -> API keys).
# Достаточно подтвердить один адрес отправителя в разделе Senders,
# свой домен не нужен, письма уходят на любые адреса. 300 писем в сутки.
BREVO_API_KEY=

# Вариант 2: Resend поверх HTTPS (resend.com/api-keys).
# Без подтверждённого домена отправляет только на адрес владельца аккаунта.
RESEND_API_KEY=

# Вариант 2: обычный SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
# Для Gmail это пароль приложения (16 символов подряд, без пробелов),
# а не пароль от аккаунта: https://myaccount.google.com/apppasswords
SMTP_PASS=

# Отправитель.
# Для Brevo — обязателен, адрес должен быть подтверждён в разделе Senders.
# Для Resend без своего домена возможен только onboarding@resend.dev,
# он подставляется сам, а публичные почтовые домены здесь игнорируются.
MAIL_FROM=НОВОСТИ СЕКУНДЫ <your-address@gmail.com>
