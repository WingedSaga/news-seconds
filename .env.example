# Сводный пример переменных окружения.
# Реальные значения кладутся в два отдельных файла:
#   server/.env  — см. server/.env.example
#   client/.env  — см. client/.env.example

# ---------- server/.env ----------
PORT=4000
NODE_ENV=development
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=article-images
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,https://your-github-username.github.io

# ---------- client/.env ----------
VITE_API_URL=http://localhost:4000/api
VITE_BASE_PATH=/
