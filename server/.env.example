# Порт HTTP-сервера
PORT=4000

# Окружение: development | production
NODE_ENV=development

# Подключение к Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Сервисный ключ. Используется только на сервере, никогда не публикуется в клиенте.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Название бакета Supabase Storage для картинок статей
SUPABASE_STORAGE_BUCKET=article-images

# Секрет для подписи JWT (длинная случайная строка)
JWT_SECRET=change-me-to-a-long-random-string
# Срок жизни токена
JWT_EXPIRES_IN=7d

# Разрешённые источники запросов, через запятую
CORS_ORIGIN=http://localhost:5173,https://your-github-username.github.io

# Адрес фронтенда — из него собирается ссылка в письме подтверждения
CLIENT_URL=http://localhost:5173

# SMTP для писем с подтверждением почты.
# Если SMTP_USER и SMTP_PASS не заданы, проверка почты выключается,
# и новые аккаунты создаются сразу подтверждёнными.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
# Для Gmail это пароль приложения (16 символов), а не пароль от аккаунта:
# https://myaccount.google.com/apppasswords
SMTP_PASS=
MAIL_FROM=НОВОСТИ СЕКУНДЫ <your-address@gmail.com>
